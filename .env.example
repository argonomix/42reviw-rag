DATABASE_URL=postgresql+psycopg://reviewrag:reviewrag@localhost:5432/reviewrag
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
RETRIEVAL_DEFAULT_MODE=hybrid
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
HYBRID_CANDIDATE_MULTIPLIER=4
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
SEED_DATA_PATH=data/seed/reviews.json
EVAL_DATA_PATH=data/eval/questions.json

# Optional. Used by `make dev` for higher Hugging Face Hub rate limits during first-time model downloads.
HF_TOKEN=
